# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# Node dependencies (match at any depth)
node_modules/
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
coverage/

# Next.js (frontend)
.next/
out/

# Build artifacts
build/
dist/
/backend/build/
/backend/dist/

# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
*.log

# Env files (keep secrets out of git)
.env*
/backend/.env*
/frontend/.env*

# Hosting / deployment
.vercel
.netlify

# Misc
.DS_Store
Thumbs.db
*.pem

# Editors/IDE
.vscode/
.idea/

# Typescript / Next typings
*.tsbuildinfo
next-env.d.ts
